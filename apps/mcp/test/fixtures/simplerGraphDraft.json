"name":"tier","type":"text","optional":true},{"name":"notice","type":"text","optional":true},{"name":"parts","type":"list","optional":true},{"name":"routine","type":"object","optional":true}],"fallback":"glm-4-7"},
    {"id":"tools","label":"Tools","goal":"Do the actual work in Context and the world: read, write, manage and send. Added only in code.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":900,"timeoutS":0,"areas":[],"file":"callToolForSession","note":"","icon":"tools","model":"code","kind":"tool","x":560,"y":60,"outSchema":[{"name":"failed","type":"yesno"},{"name":"chars","type":"number"}],"inSchema":[{"name":"kind","type":"choice","options":"mcp, web, local"},{"name":"name","type":"text"},{"name":"call","type":"number"}],"group":"tools-subagents"},
