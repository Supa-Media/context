    {"id":"job","label":"Background job","goal":"Do long work (browsing, forms, many steps) without holding up the reply.","log":true,"on":true,"rounds":12,"out":400,"ctx":["tools","map","p-about-tex","p-rules","p-tools","p-working","train:job","brief","ask","date"],"ms":0,"timeoutS":0,"areas":["jobs"],"file":"graph/nodes/job.js · texJob.js · apps/agent jobRun.ts","note":"","icon":"job","model":"haiku-5-5","effort":"medium","x":840,"y":60,"inSchema":[{"name":"step","type":"choice","options":"pass, failed"},{"name":"jobId","type":"text"}],"outSchema":[{"name":"next","type":"choice","options":"done, now, after"},{"name":"ms","type":"number"},{"name":"attempt","type":"number"},{"name":"sent","type":"number"},{"name":"running","type":"yesno"}],"group":"jobs"},
    {"id":"handback","label":"Hand-back judge","goal":"Make sure what a job hands back is true and finished before the person hears it.","log":false,"on":true,"rounds":1,"out":200,"ctx":["own","train:handback","brief","draft"],"ms":0,"timeoutS":0,"areas":["jobs"],"file":"graph/nodes/handback.js · handbackJudge.js · claimCheck.js","note":"","icon":"judge","model":"haiku-5-5","effort":"low","x":1320,"y":40,"inSchema":[{"name":"question","type":"text"},{"name":"answer","type":"text"},{"name":"steps","type":"list"}],"outSchema":[{"name":"judged","type":"yesno"},{"name":"codes","type":"ids"},{"name":"sentBack","type":"text"},{"name":"notice","type":"text"}],"group":"jobs"},
    {"id":"egress","label":"Egress judge","goal":"Let a step that widens who can see something, or acts in the person's name, run only when the person's own words ask for it; anything but a clear yes is a no.","log":true,"on":true,"rounds":1,"out":120,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"privacy/judge.js","note":"","icon":"shield","model":"haiku-5-5","effort":"low","x":1320,"y":10,"inSchema":[{"name":"words","type":"text"},{"name":"action","type":"text"},{"name":"workspace","type":"text","optional":true},{"name":"subject","type":"object","optional":true}],"outSchema":[{"name":"allow","type":"yesno"},{"name":"reason","type":"text"}],"group":"tools-subagents"},
    {"id":"picture","label":"Picture maker","goal":"Draw a card or graphic, or make a photo with Gemini, for a texted answer; every one is looked at by Card check before it may go.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"pictureMaker.js","note":"","icon":"card","model":"gemini","effort":"off","x":1320,"y":120,"inSchema":[{"name":"tool","type":"choice","options":"draw_visual, draw_picture, make_picture, write_note"},{"name":"args","type":"object"}],"outSchema":[{"name":"result","type":"object"}],"group":"tools-subagents"},
    {"id":"doorStep","label":"Door","goal":"Gather what the turn needs in code before any model runs (the text, the question, a yes or no, what may leave, may it run, history, web, setup, bookkeeping), each part logged inside this step; a text it can settle in code (a yes or thumbs-up, a refusal) goes to Confirmations & refusals.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":["core","pipeline"],"file":"graph/nodes/doorStep.js · graph/door.js · texEntryPoint/*","note":"","icon":"door","model":"code","x":440,"y":330,"group":"intake","outSchema":[{"name":"texted","type":"yesno","optional":true},{"name":"claims","type":"yesno","optional":true},{"name":"tries","type":"yesno","optional":true},{"name":"forwarding","type":"number","optional":true},{"name":"pictures","type":"yesno","optional":true},{"name":"knowsStarted","type":"yesno","optional":true},{"name":"status","type":"number","optional":true},{"name":"parts","type":"list","optional":true},{"name":"answeredBy","type":"text","optional":true}]},
    {"id":"bypass","label":"Confirmations & refusals","goal":"Answers the door settles in code, with no model: a yes, no or thumbs-up to something Tex is waiting on (including a computer step), and the short refusals (a request that can't be read, a question too long, not allowed to run, the model unavailable), and a routine's run that ends before any model (paused, gone, or a job that needs none). Logs which one, then hands it to Text them.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":["core"],"file":"graph/nodes/bypass.js","note":"","icon":"code","model":"code","x":280,"y":500,"inSchema":[{"name":"answeredBy","type":"text"},{"name":"parts","type":"list","optional":true},{"name":"status","type":"number","optional":true},{"name":"routine","type":"object","optional":true}],"outSchema":[{"name":"answeredBy","type":"text"},{"name":"status","type":"number","optional":true}]},
    {"id":"answerCheck","label":"Answer check","goal":"Check a draft before it goes: code first catches what it can prove wrong (a claim with no call behind it, a figure nothing showed, a missing link); for a job's report or a routine's text a model then reads it as the person would. Either can send it back to the front door.","log":true,"on":true,"rounds":1,"out":350,"ctx":["own","train:reviewer","ledger","ask","draft","hist","date"],"ms":0,"timeoutS":8,"areas":["review"],"file":"graph/nodes/answerCheck.js · doItChecks.js · replyJudge.js · sendBack.js","note":"","icon":"judge","model":"haiku-5-5","effort":"low","x":560,"y":340,"inSchema":[{"name":"pending","type":"yesno"},{"name":"draftChars","type":"number","optional":true},{"name":"actions","type":"number","optional":true},{"name":"ended","type":"yesno","optional":true},{"name":"status","type":"number","optional":true},{"name":"answeredBy","type":"text","optional":true},{"name":"steps","type":"number","optional":true},{"name":"exhausted","type":"yesno","optional":true},{"name":"model","type":"text","optional":true},{"name":"effort","type":"text","optional":true},{"name":"fallback","type":"text","optional":true},{"name":"router","type":"yesno","optional":true},{"name":"reviewer","type":"text","optional":true},{"name":"advisor","type":"text","optional":true},{"name":"planner","type":"text","optional":true},{"name":"computers","type":"number","optional":true},{"name":"skills","type":"number","optional":true},{"name":"delegation","type":"yesno","optional":true},{"name":"threads","type":"yesno","optional":true}],"outSchema":[{"name":"pending","type":"yesno"},{"name":"draftChars","type":"number","optional":true},{"name":"actions","type":"number","optional":true},{"name":"ended","type":"yesno","optional":true},{"name":"status","type":"number","optional":true},{"name":"answeredBy","type":"text","optional":true},{"name":"steps","type":"number","optional":true},{"name":"exhausted","type":"yesno","optional":true},{"name":"m