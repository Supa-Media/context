    {"id":"learn","label":"Learn","goal":"After a texted turn, write what was learned: About me every ten texts or when the answer was about them, and a learned skill after a hard or corrected turn.","log":true,"on":true,"rounds":4,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"graph/nodes/learn.js · reflect.js · memoryNudge.js","note":"","icon":"star","model":"haiku-5-5","effort":"low","x":1400,"y":400,"inSchema":[{"name":"question","type":"text"},{"name":"answer","type":"text"},{"name":"tainted","type":"yesno"},{"name":"ownText","type":"yesno"},{"name":"canWrite","type":"yesno"}],"outSchema":[{"name":"reflect","type":"object"},{"name":"nudge","type":"object"}]},
    {"id":"afterReply","label":"After the reply","goal":"After the reply, file the new text into the chat's conversation threads, and score the conversation on a reply that went, filing a review when something went wrong.","log":true,"on":true,"rounds":1,"out":300,"ctx":["own","train:classifier","train:selfreview","threads","recent","hist"],"ms":0,"timeoutS":4,"areas":[],"file":"graph/nodes/afterReply.js · conversationThreads.js · selfReview.js","note":"","icon":"thread","model":"haiku-5-5","effort":"off","x":1400,"y":280,"inSchema":[{"name":"texts","type":"number","optional":true},{"name":"card","type":"yesno","optional":true},{"name":"reaction","type":"yesno","optional":true},{"name":"status","type":"number","optional":true}],"outSchema":[{"name":"filed","type":"number","optional":true},{"name":"reviewed","type":"yesno","optional":true}]},
    {"id":"jobadv","label":"Job advisor","goal":"Check a job's work as it goes and steer it when it drifts; answer a job's question on its note's mail before it acts.","log":true,"on":true,"rounds":3,"out":600,"ctx":["own","train:jobcheck","train:mailadv","brief","ask","ledger","out:job"],"ms":0,"timeoutS":0,"areas":["advisor-job-check","advisor-job-mail","jobs"],"file":"graph/nodes/jobadv.js · jobCheck.js · advisorRoles/jobMail.js","note":"","icon":"advisor","model":"opus-5-5","effort":"high","x":1320,"y":140,"group":"jobs","inSchema":[{"name":"role","type":"choice","options":"check, mail"},{"name":"job","type":"object","optional":true},{"name":"answer","type":"text","optional":true},{"name":"exhausted","type":"yesno","optional":true},{"name":"jobId","type":"text","optional":true},{"name":"title","type":"text","optional":true},{"name":"brief","type":"text","optional":true},{"name":"doneWhen","type":"text","optional":true},{"name":"from","type":"text","optional":true},{"name":"question","type":"text","optional":true},{"name":"noteText","type":"text","optional":true}],"outSchema":[{"name":"verdict","type":"choice","options":"done, keep_going, waiting, stuck, none","optional":true},{"name":"advice","type":"text","optional":true},{"name":"thinking","type":"text","optional":true},{"name":"model","type":"text","optional":true},{"name":"words","type":"text","optional":true},{"name":"ok","type":"yesno","optional":true}]},
