{
  "searchConfig": 1,
  "about": "Search's own config (Dev2, 2026-11-21: \"not only Tex uses search\"): every step a search runs, its settings and the wires between them. Read by the gateway's search for every caller (an AI client's search_notes, the app's search bar, Tex) through searchConfig.cjs, and edited in the Lab on the Search page. A Lab Promote changes this file in a pull request.",
  "nodes": [
    {
      "id": "search",
      "label": "Search",
      "goal": "A search arrives (an AI client's search_notes, the app's search bar, Tex): pick the workspaces it asks, every one the person reaches unless a folder, a scope or the person's setting narrows it.",
      "on": true,
      "model": "code",
      "kind": "input",
      "icon": "door",
      "file": "apps/mcp/src/search/config/nodes.js",
      "x": 0,
      "y": 0,
      "settings": {},
      "inSchema": [
        {
          "name": "query",
          "type": "text"
        },
        {
          "name": "prefix",
          "type": "text"
        },
        {
          "name": "only",
          "type": "list",
          "optional": true
        },
        {
          "name": "boost",
          "type": "text",
          "optional": true
        }
      ],
      "outSchema": [
        {
          "name": "to",
          "type": "choice",
          "options": "each, none"
        },
        {
          "name": "query",
          "type": "text"
        },
        {
          "name": "prefix",
          "type": "text"
        },
        {
          "name": "names",
          "type": "ids"
        },
        {
          "name": "here",
          "type": "yesno"
        },
        {
          "name": "boost",
          "type": "text",
          "optional": true
        }
      ]
    },
    {
      "id": "each",
      "label": "Search each workspace",
      "goal": "Every workspace asked, at once: in each it opens the workspace as the person, finds notes by words and by meaning side by side, merges the two lists, lowers logs and archive, and adds the closest notes only meaning found. Each of those is its own step below, run once per workspace.",
      "on": true,
      "model": "code",
      "icon": "router",
      "file": "apps/mcp/src/search/config/nodes.js",
      "x": 560,
      "y": 0,
      "settings": {},
      "inSchema": [
        {
          "name": "to",
          "type": "choice",
          "options": "each"
        },
        {
          "name": "query",
          "type": "text"
        },
        {
          "name": "prefix",
          "type": "text"
        },
        {
          "name": "names",
          "type": "ids"
        },
        {
          "name": "here",
          "type": "yesno"
        },
        {
          "name": "boost",
          "type": "text",
          "optional": true
        }
      ],
      "outSchema": [
        {
          "name": "to",
          "type": "choice",
          "options": "one, several"
        },
        {
          "name": "answer",
          "type": "object",
          "optional": true
        },
        {
          "name": "query",
          "type": "text",
          "optional": true
        },
        {
          "name": "boost",
          "type": "text",
          "optional": true
        },
        {
          "name": "workspaces",
          "type": "list",
          "optional": true
        },
        {
          "name": "unreached",
          "type": "ids",
          "optional": true
        }
      ]
    },
    {
      "id": "open",
      "label": "Open the workspace as you",
      "goal": "Open one workspace the way a tool call naming it does: the person's role there and its own privacy rules, which every later step checks each note against (canSee). One that cannot be opened or read now is left out and named unreached, never guessed at.",
      "on": true,
      "model": "code",
      "icon": "shield",
      "file": "apps/mcp/src/search/config/nodes.js \u00b7 privacy/state.js",
      "x": 80,
      "y": 200,
      "settings": {},
      "inSchema": [
        {
          "name": "workspace",
          "type": "text"
        },
        {
          "name": "here",
          "type": "yesno"
        }
      ],
      "outSchema": [
        {
          "name": "workspace",
          "type": "text"
        },
        {
          "name": "reached",
          "type": "yesno"
        },
        {
          "name": "scope",
          "type": "text",
          "optional": true
        },
        {
          "name": "rules",
          "type": "number",
          "optional": true
        }
      ]
    },
    {
      "id": "words",
      "label": "Find by words",
      "goal": "The word index: notes holding the query's words, ranked by BM25 with titles and headings weighted, retried with any word when no note holds them all (those hits are marked loose). Only notes the person may see; the path it took (object, database, index or scan) is logged.",
      "on": true,
      "model": "code",
      "icon": "text",
      "file": "apps/mcp/src/search/visibleNotes.js \u00b7 objectSearch.js",
      "x": 280,
      "y": 200,
      "settings": {},
      "inSchema": [
        {
          "name": "workspace",
          "type": "text"
        },
        {
          "name": "here",
          "type": "yesno"
        },
        {
          "name": "query",
          "type": "text"
        },
        {
          "name": "prefix",
          "type": "text"
        }
      ],
      "outSchema": [
        {
          "name": "found",
          "type": "object"
        }
      ]
    },
    {
      "id": "meaning",
      "label": "Find by meaning",
      "goal": "Embed the query (once per search, shared by every workspace) and find the nearest passages in the workspace's meaning index, at least minScore close. Only notes the person may see, never a log of the plumbing or a search probe.",
      "on": true,
      "model": "code",
      "icon": "star",
      "file": "apps/mcp/src/search/meaning/serve.js meaningMatches",
      "x": 480,
      "y": 200,
      "settings": {
        "minScore": 0.4
      },
      "inSchema": [
        {
          "name": "workspace",
          "type": "text"
        },
        {
          "name": "here",
          "type": "yesno"
        },
        {
          "name": "query",
          "type": "text"
        },
        {
          "name": "prefix",
          "type": "text"
        }
      ],
      "outSchema": [
        {
          "name": "matches",
          "type": "list",
          "optional": true
        },
        {
          "name": "off",
          "type": "yesno"
        }
      ]
    },
    {
      "id": "merge",
      "label": "Merge words and meaning",
      "goal": "One list from the two by reciprocal rank (rrfK), a note both find rising. A note only meaning found joins only when close (meaningFloor) once the words found a note with every word; a word hit adds its title (titleWeight) and phrase (phraseBonus) evidence; a hit whose words sit only in a link counts as loose, and loose hits go last.",
      "on": true,
      "model": "code",
      "icon": "wire",
      "file": "apps/mcp/src/search/meaning/serve.js mergeWithMeaning \u00b7 evidence.js",
      "x": 680,
      "y": 200,
      "settings": {
        "meaningFloor": 0.5,
        "rrfK": 60,
        "titleWeight": 0.003278688524590164,
        "phraseBonus": 0.00819672131147541,
        "snippetPhraseBonus": 0.00819672131147541
      },
      "inSchema": [
        {
          "name": "workspace",
          "type": "text"
        },
        {
          "name": "query",
          "type": "text",
          "optional": true
        },
        {
          "name": "found",
          "type": "object"
        },
        {
          "name": "matches",
          "type": "list",
          "optional": true
        },
        {
          "name": "off",
          "type": "yesno"
        }
      ],
      "outSchema": [
        {
          "name": "merged",
          "type": "object"
        }
      ]
    },
    {
      "id": "prior",
      "label": "Lower logs and archive",
      "goal": "Scale each merged score by where the note lives: an archived note, a log (Inbox captures of messages, email, calendar, Tex's own logs, review logs, retired setups) scores logPrior of a live note with the same evidence. It only reorders.",
      "on": true,
      "model": "code",
      "icon": "queue",
      "file": "apps/mcp/src/search/priors.js \u00b7 meaning/serve.js lowerLogs",
      "x": 880,
      "y": 200,
      "settings": {
        "logPrior": 0.5,
        "inboxPrior": 1
      },
      "inSchema": [
        {
          "name": "workspace",
          "type": "text"
        },
        {
          "name": "merged",
          "type": "object"
        }
      ],
      "outSchema": [
        {
          "name": "merged",
          "type": "object"
        }
      ]
    },
    {
      "id": "snippets",
      "label": "Add meaning-only notes",
      "goal": "Read a snippet for the closest notes only meaning found, at most extraNotes of them (looseReads when no note held every word), snippetChars long; a passage of code is not offered for a question in prose. Answers the workspace's hits, each with its evidence for ranking across workspaces.",
      "on": true,
      "model": "code",
      "icon": "card",
      "file": "apps/mcp/src/search/meaning/serve.js addMeaningOnly",
      "x": 1080,
      "y": 200,
      "settings": {
        "extraNotes": 3,
        "snippetChars": 200,
        "looseReads": 6
      },
      "inSchema": [
        {
          "name": "workspace",
          "type": "text"
        },
        {
          "name": "query",
          "type": "text",
          "optional": true
        },
        {
          "name": "merged",
          "type": "object"
        }
      ],
      "outSchema": [
        {
          "name": "found",
          "type": "object"
        }
      ]
    },
    {
      "id": "fuse",
      "label": "Rank across workspaces",
      "goal": "One list from every workspace's, ranked by evidence rather than by workspace: word rank (a loose hit counted lower), rank among every meaning match, title and phrase evidence, the path prior and a named workspace's boost; at most the hits setting shown.",
      "on": true,
      "model": "code",
      "icon": "judge",
      "file": "apps/mcp/src/search/config/nodes.js \u00b7 tools/search.js",
      "x": 1240,
      "y": 0,
      "settings": {
        "hits": 12,
        "rrfK": 60,
        "loosePenalty": 10,
        "titleWeight": 0.003278688524590164,
        "phraseBonus": 0.00819672131147541,
        "snippetPhraseBonus": 0.00819672131147541,
        "meaningFloor": 0.5,
        "looseReads": 6,
        "boostFactor": 1.2,
        "logPrior": 0.5,
        "inboxPrior": 1
      },
      "inSchema": [
        {
          "name": "to",
          "type": "choice",
          "options": "several"
        },
        {
          "name": "query",
          "type": "text"
        },
        {
          "name": "boost",
          "type": "text",
          "optional": true
        },
        {
          "name": "workspaces",
          "type": "list"
        },
        {
          "name": "unreached",
          "type": "ids"
        }
      ],
      "outSchema": [
        {
          "name": "answer",
          "type": "object"
        }
      ]
    }
  ],
