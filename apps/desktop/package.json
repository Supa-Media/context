{
  "name": "@context/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Meeting capture on the desktop — notices the meeting, records it without a bot joining the call, and writes the note into the customer's own bucket",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron dist/main/index.js",
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "test": "node --experimental-strip-types test/test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no lint configured yet\" && exit 0",
    "package": "node scripts/build.mjs && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "@supa-media/context-hook": "workspace:*",
    "@context/meetings": "workspace:*"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.0",
    "@types/node": "^22.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
