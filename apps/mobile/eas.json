{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_CONVEX_URL": "REPLACED_BY_CI",
        "EAS_PROJECT_ID": "REPLACED_BY_CI"
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_CONVEX_URL": "REPLACED_BY_CI",
        "EAS_PROJECT_ID": "REPLACED_BY_CI",
        "EXPO_PUBLIC_MCP_URL": "https://mcp-staging.context.lc/mcp",
        "EXPO_PUBLIC_SITE_ORIGIN": "https://staging.context.lc"
      },
      "channel": "staging",
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_CONVEX_URL": "REPLACED_BY_CI",
        "EAS_PROJECT_ID": "REPLACED_BY_CI"
      },
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
