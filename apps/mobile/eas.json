{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_CONVEX_URL": "https://clean-ptarmigan-116.convex.cloud"
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_CONVEX_URL": "https://clean-ptarmigan-116.convex.cloud"
      },
      "channel": "staging",
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_CONVEX_URL": "https://clean-ptarmigan-116.convex.cloud"
      },
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "647N4W6575"
      }
    }
  }
}
