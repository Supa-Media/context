{
  // context-agent: the Worker behind the Context assistant people text over
  // iMessage. See src/index.ts for the flow.
  //
  // Staging deploys on every merge that changes it (deploy-staging.yml), and
  // production with each release that changes it (deploy-agent-worker.yml).
  //
  // Staging alone sets SIMULATOR to "on", which serves the texts simulator at
  // /texts-simulator (src/simulator.ts): a made-up iPhone that texts the
  // assistant without Linq. The staging router forwards that path here, and
  // the production deploy checks it answers 404.
  //
  // Secrets, set by the deploy from the GitHub environment, never committed:
  //
  //   LINQ_WEBHOOK_SECRET   the `whsec_…` secret Linq returns when the webhook
  //                         subscription is created (shown once). Absent, every
  //                         delivery is refused, which is the safe direction.
  //   LINQ_API_KEY          Linq Partner API key, for sending replies
  //   SENDBLUE_API_KEY_ID, SENDBLUE_API_SECRET
  //                         Sendblue API keys, for replies on Tex's dedicated line
  //   SENDBLUE_WEBHOOK_SECRET
  //                         the secret set on Sendblue's receive webhook, which
  //                         points at https://<this worker>/sendblue. Absent,
  //                         every delivery is refused.
  //   WHAPI_TOKEN           the Whapi.Cloud channel's API token (Bearer), for
  //                         replies on Tex's WhatsApp line
  //   WHAPI_LINE            Tex's own WhatsApp number in E.164. A secret rather
  //                         than a var because this repository is public.
  //   WHAPI_WEBHOOK_SECRET  a random value of 16+ characters that Whapi sends on
  //                         every delivery in the x-tex-webhook-secret header.
  //                         The webhook is https://<this worker>/whapi. Absent,
  //                         every delivery is refused. All three absent means
  //                         the WhatsApp line is simply off; it is never a
  //                         failed deploy.
  //   AGENT_WORKER_SECRET   opens the control plane's /agent-texts/* routes only
  //   CONTROL_PLANE_ORIGIN  the Convex HTTP origin, from CONTROL_PLANE_URL. A
  //                         secret rather than a var because this repository is
  //                         public and the hostname names a deployment.
  //
  // The webhook subscription points at https://<this worker>/linq and subscribes
  // to `message.received` only. `GET /health` reports which of the above are set
  // (booleans only), and the deploy reads it.
  //
  // The Cron Trigger runs every minute and runs whatever routines are due
  // (src/routines.ts): it asks the control plane which runs are due, runs each
  // on the gateway's /agent with that run's own grant, texts the answer to the
  // phones that texted this line first, and reports an outcome and a count.
  // It pulls with AGENT_WORKER_SECRET, so it needs no secret of its own, and
  // without CONTROL_PLANE_ORIGIN or that secret it does nothing. The same tick
  // runs Tex's nightly dreams (src/dreams.ts) the same way; a dream texts nobody.
  //
  // GATEWAY_ORIGIN is the gateway's own host (apps/mcp/wrangler.toml
  // PUBLIC_ORIGIN), not the app's: context.lc is the router, and `/agent` there
  // is a web page, not the gateway.
  "name": "context-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "SENDER_INBOX", "class_name": "SenderInbox" }]
  },
  "migrations": [{ "tag": "v1-sender-inbox", "new_sqlite_classes": ["SenderInbox"] }],
  // Each group turn is one instance, retried by Workflows (src/groupTurnWorkflow.ts).
  "workflows": [
    { "name": "group-turn", "binding": "GROUP_TURN", "class_name": "GroupTurnWorkflow" },
    { "name": "job-run", "binding": "JOB_RUN", "class_name": "JobRunWorkflow" }
  ],
  "vars": {
    "GATEWAY_ORIGIN": "https://mcp.context.lc",
    // A link to a note goes as a Context card when "on" (src/appCards.ts);
    // the team id is the APPLE_TEAM_ID secret. Off until the Messages
    // extension ships, so a tap opens the note.
    "APP_CARDS": "off",
    "APP_CARD_EXTENSION_ID": "lc.context.mobile.messages"
  },
  "triggers": { "crons": ["* * * * *"] },
  // Converts a texted iPhone photo (HEIC) to a JPEG the model can read
  // (src/attachments.ts). Without it, such a photo is described, not shown.
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "context-agent-staging",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [{ "name": "SENDER_INBOX", "class_name": "SenderInbox" }]
      },
      "migrations": [{ "tag": "v1-sender-inbox", "new_sqlite_classes": ["SenderInbox"] }],
      "workflows": [
        { "name": "group-turn-staging", "binding": "GROUP_TURN", "class_name": "GroupTurnWorkflow" },
        { "name": "job-run-staging", "binding": "JOB_RUN", "class_name": "JobRunWorkflow" }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "images": { "binding": "IMAGES" },
      "vars": {
        "GATEWAY_ORIGIN": "https://mcp-staging.context.lc",
        "SIMULATOR": "on",
        "APP_CARDS": "off",
        "APP_CARD_EXTENSION_ID": "lc.context.staging.messages"
      }
    }
  }
}
