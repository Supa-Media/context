{
  // context-agent: the Worker behind the Context assistant people text over
  // iMessage. See src/index.ts for the flow.
  //
  // Staging deploys on every merge that changes it (deploy-staging.yml), and
  // production with each release that changes it (deploy-agent-worker.yml).
  //
  // Staging alone sets SIMULATOR to "on", which serves the texts simulator at
  // /texts-simulator (src/simulator.ts): a made-up iPhone that texts the
  // assistant without Linq. The staging router forwards that path here, and
  // the production deploy checks it answers 404.
  //
  // Secrets, set by the deploy from the GitHub environment, never committed:
  //
  //   LINQ_WEBHOOK_SECRET   the `whsec_…` secret Linq returns when the webhook
  //                         subscription is created (shown once). Absent, every
  //                         delivery is refused, which is the safe direction.
  //   LINQ_API_KEY          Linq Partner API key, for sending replies
  //   SENDBLUE_API_KEY_ID, SENDBLUE_API_SECRET
  //                         Sendblue API keys, for replies on Tex's dedicated line
  //   SENDBLUE_WEBHOOK_SECRET
  //                         the secret set on Sendblue's receive webhook, which
  //                         points at https://<this worker>/sendblue. Absent,
  //                         every delivery is refused.
  //   WHAPI_TOKEN           the Whapi.Cloud channel's API token (Bearer), for
  //                         replies on Tex's WhatsApp line
  //   WHAPI_LINE            Tex's own WhatsApp number in E.164. A secret rather
  //                         than a var because this repository is public.
  //   WHAPI_WEBHOOK_SECRET  a random value of 16+ characters that Whapi sends on
  //                         every delivery in the x-tex-webhook-secret header.
  //                         The webhook is https://<this worker>/whapi. Absent,
  //                         every delivery is refused. All three absent means
  //                         the WhatsApp line is simply off; it is never a
  //                         failed deploy.
  //   AGENT_WORKER_SECRET   opens the control plane's /agent-texts/* routes only
  //   CONTROL_PLANE_ORIGIN  the Convex HTTP origin, from CONTROL_PLANE_URL. A
  //                         secret rather than a var because this repository is
  //                         public and the hostname names a deployment.
  //
  // The webhook subscription points at https://<this worker>/linq and subscribes
  // to `message.received` only. `GET /health` reports which of the above are set
  // (booleans only), and the deploy reads it.
  //
  // The Cron Trigger runs every minute and runs whatever routines are due
  // (src/routines.ts): it asks the control plane which runs are due, runs each
  // on the gateway's /agent with that run's own grant, texts the answer to the
  // phones that texted this line first, and reports an outcome and a count.
  // It pulls with AGENT_WORKER_SECRET, so it needs no secret of its own, and
  // without CONTROL_PLANE_ORIGIN or that secret it does nothing. The same tick
  // runs Tex's nightly dreams (src/dreams.ts) the same way; a dream texts nobody.
  //
  // GATEWAY_ORIGIN is the gateway's own host (apps/mcp/wrangler.toml
  // PUBLIC_ORIGIN), not the app's: context.lc is the router, and `/agent` there
  // is a web page, not the gateway.
  "name": "context-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "SENDER_INBOX", "class_name": "SenderInbox" }]
  },
  "migrations": [{ "tag": "v1-sender-inbox", "new_sqlite_classes": ["SenderInbox"] }],
  // Each group turn is one instance, retried by Workflows (src/groupTurnWorkflow.ts).
  "workflows": [
    { "name": "group-turn", "binding": "GROUP_TURN", "class_name": "GroupTurnWorkflow" },
    { "name": "job-run", "binding": "JOB_RUN", "class_name": "JobRunWorkflow" }
  ],
  "vars": {
    "GATEWAY_ORIGIN": "https://mcp.context.lc",
    // Where an incoming text's head runs (src/handOver.ts): "gateway" hands it to the gateway's TexChat (`/texts/arrive`),
    // "worker" keeps the SenderInbox queue. The move is step 3 of Tex's config graph (docs/architecture/tex.md).
    // Production moved on Dev2's go (2026-11-21), after Dev2's 1:1 and Tex Devs were moved first and checked
    // (docs/decisions/texting-assistant/chat-in-gateway.md). A chat moves on its next text; a copy that fails or finds
    // the chat busy leaves the SenderInbox answering, and the move is tried again.
    "INTAKE": "gateway",
    // Where a background job's object runs (src/jobPlace.ts): "gateway" starts new jobs in the gateway's TexJob, "worker"
    // keeps them in the SenderInbox. A job the gateway holds is reached there whatever this says. Production moved on
    // Dev2's go (2026-11-14); a job that started in the SenderInbox finishes there.
    "JOBS": "gateway",
    // Context cards (src/appCards.ts, src/cardChats.ts): "on" for every
    // chat, "app" only for chats whose person has shown they have the
    // Context app (a card from its Messages extension reached Tex), "off".
    // The team id is the APPLE_TEAM_ID secret.
    "APP_CARDS": "app",
    "APP_CARD_EXTENSION_ID": "lc.context.mobile.messages"
  },
  "triggers": { "crons": ["* * * * *"] },
  // Converts a texted iPhone photo (HEIC) to a JPEG the model can read
  // (src/attachments.ts). Without it, such a photo is described, not shown.
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  // Each answered text's wait, from arrival to its first bubble out
  // (src/textTiming.ts): a kind and milliseconds, never a number or a word.
  // Read with the account's Analytics Engine SQL API. Optional when
  // self-hosting: without it nothing is written.
  // TEX_COUNTS: each text in and out and who texted, for tex.lc/admin (`src/textCounts.ts`); ids and counts only.
  "analytics_engine_datasets": [
    { "binding": "TEX_TEXTS", "dataset": "tex_text_timing" },
    { "binding": "TEX_COUNTS", "dataset": "tex_text_counts" }
  ],
  // The gateway's `TexTexts` entrypoint (packages/tex/gateway/agent/textsSession.js): a text's session from the person object,
  // without Convex. A named entrypoint is reachable only through this binding, so there is no secret to set. The
  // gateway must have deployed the entrypoint first. Self-hosting without it: delete this block; sessions are Convex's.
  "services": [
    { "binding": "GATEWAY_TEXTS", "service": "context-mcp", "entrypoint": "TexTexts" },
    // The Photon bridge (infra/photon-bridge): Tex's sends on photon: chats. It answers 503 "unconfigured" until its secrets are set.
    { "binding": "PHOTON", "service": "context-photon-bridge" }
  ],
  "env": {
    "staging": {
      "name": "context-agent-staging",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [{ "name": "SENDER_INBOX", "class_name": "SenderInbox" }]
      },
      "migrations": [{ "tag": "v1-sender-inbox", "new_sqlite_classes": ["SenderInbox"] }],
      "workflows": [
        { "name": "group-turn-staging", "binding": "GROUP_TURN", "class_name": "GroupTurnWorkflow" },
        { "name": "job-run-staging", "binding": "JOB_RUN", "class_name": "JobRunWorkflow" }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "images": { "binding": "IMAGES" },
      "analytics_engine_datasets": [
        { "binding": "TEX_TEXTS", "dataset": "tex_text_timing_staging" },
        { "binding": "TEX_COUNTS", "dataset": "tex_text_counts_staging" }
      ],
      "services": [
        { "binding": "GATEWAY_TEXTS", "service": "context-mcp-staging", "entrypoint": "TexTexts" },
        { "binding": "PHOTON", "service": "context-photon-bridge-staging" }
      ],
      "vars": {
        "GATEWAY_ORIGIN": "https://mcp-staging.context.lc",
        // Where an incoming text's head runs (src/handOver.ts): "gateway" or "worker", as at the top level. Staging runs
        // its chats in the gateway first (2026-11-14, step 3 of Tex's config graph); production follows once proven.
        "INTAKE": "gateway",
        // Where a background job's object runs (src/jobPlace.ts), as at the top level.
        "JOBS": "gateway",
        "SIMULATOR": "on",
        "APP_CARDS": "app",
        "APP_CARD_EXTENSION_ID": "lc.context.staging.messages"
      }
    },
    // Preview: a throwaway copy of the texting Worker for one pull request, reached only through that pull
    // request's own preview gateway and router. Its names and hosts are placeholders (__PREVIEW__ and
    // __WORKERS_DEV__) that packages/sandbox/src/config.mjs renders into a copy beside this file. Never deploy this
    // section directly: the rendered copy is the only thing that goes out. It has no Sendblue, Linq, Whapi or
    // Photon binding and no secret of its own, so it can send nothing: the preview's texts come from the texts
    // simulator alone. Context cards are off, since a card would go out on the real iMessage path.
    "preview": {
      "name": "context-agent-__PREVIEW__",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [{ "name": "SENDER_INBOX", "class_name": "SenderInbox" }]
      },
      "migrations": [{ "tag": "v1-sender-inbox", "new_sqlite_classes": ["SenderInbox"] }],
      "workflows": [
        { "name": "group-turn-__PREVIEW__", "binding": "GROUP_TURN", "class_name": "GroupTurnWorkflow" },
        { "name": "job-run-__PREVIEW__", "binding": "JOB_RUN", "class_name": "JobRunWorkflow" }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "images": { "binding": "IMAGES" },
      "analytics_engine_datasets": [
        { "binding": "TEX_TEXTS", "dataset": "tex_text_timing_preview" },
        { "binding": "TEX_COUNTS", "dataset": "tex_text_counts_preview" }
      ],
      "services": [
        { "binding": "GATEWAY_TEXTS", "service": "context-mcp-__PREVIEW__", "entrypoint": "TexTexts" }
      ],
      "vars": {
        "GATEWAY_ORIGIN": "https://context-mcp-__PREVIEW__.__WORKERS_DEV__",
        "INTAKE": "gateway",
        "JOBS": "gateway",
        "SIMULATOR": "on",
        "APP_CARDS": "off",
        "APP_CARD_EXTENSION_ID": "lc.context.staging.messages"
      }
    }
  }
}
