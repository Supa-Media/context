# Convex
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=

# Resend (Email OTP)
RESEND_API_KEY=op://Context/Resend/api-key

# Storage credential encryption.
#
# The AES-256-GCM key that encrypts every customer's bucket credentials at
# rest. Losing it orphans every storage binding; leaking it exposes all of
# them. Generate once with generateEncryptionKey() in
# apps/convex/functions/lib/crypto.ts, store it in 1Password, and set it in the
# Convex environment. It must never be committed, logged, or written into a
# customer's bucket.
STORAGE_SECRET_ENCRYPTION_KEY=op://Context/Storage encryption/key

# Sentry
SENTRY_DSN=op://Context/Sentry/dsn
