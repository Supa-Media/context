# Convex
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=

# Resend — sign-in codes AND invitation mail.
#
# Unset, this deployment sends no mail at all: sign-in codes are logged to the
# console instead, and an invitation is written but never delivered. That is a
# working development setup, not a broken one — `listMyInvitations` is still
# how an invitation is answered in-app, and it is the only channel a `@name`
# invitee ever had.
RESEND_API_KEY=op://Context/RESEND_API_KEY/production

# The From: address on both. Falls back to a placeholder that will not deliver,
# so set it on any deployment that has a Resend key.
AUTH_EMAIL_FROM=op://Context/AUTH_EMAIL_FROM/production

# Where a link in an email points, e.g. https://app.context.lc — no trailing
# slash.
#
# Read by three things now, and the third one constrains what this may be.
#
# Two build a URL a person will click: the OAuth consent screen
# (`consentUrlFor`) and the invitation email. Both refuse to guess — unset,
# they throw rather than emitting a relative or http:// link, and https is
# enforced. An invitation with a link to the wrong origin is worse than one
# that was never sent, because it is a link somebody will follow.
#
# The third is the Dropbox connect flow. `dropboxRedirectAllowed` pins the
# callback to exactly this origin, so **it must be the origin whose callback
# URL is registered in the Dropbox app console** — on the product deployment
# that is the apex `https://context.lc`, which the router fronts with the web
# app, and not an `app.` subdomain. Set it to something else and every Dropbox
# connect is refused with `REDIRECT_URI_NOT_ALLOWED`. That is fail-closed and
# not dangerous, but it is a total break of that feature, and no test can
# catch it because the value lives here rather than in the repo.
#
# The pin is deliberate: without it the connect flow accepts any https
# redirect a caller supplies, which is a confused deputy with our consent
# screen on the front of it.
APP_ORIGIN=op://Context/APP_ORIGIN/production

# Storage credential encryption.
#
# The AES-256-GCM key that encrypts every customer's bucket credentials at
# rest. Losing it orphans every storage binding; leaking it exposes all of
# them. Generate once with generateEncryptionKey() in
# apps/convex/functions/lib/crypto.ts, store it in 1Password, and set it in the
# Convex environment. It must never be committed, logged, or written into a
# customer's bucket.
STORAGE_SECRET_ENCRYPTION_KEY=op://Context/STORAGE_SECRET_ENCRYPTION_KEY/production

# Identifies which key encrypted a given envelope, so a rotation can tell its
# own records apart. Envelopes are v2:<key-id>:<iv>:<ciphertext>.
STORAGE_SECRET_ENCRYPTION_KEY_ID=current

# Key rotation (optional — set only while a rotation is in flight).
#
# Reads try the current key and then the previous one; writes always use the
# current key. Set both PREVIOUS vars together: a previous key without its id,
# or two keys sharing one id, is refused rather than guessed.
#
# Runbook: set the new key as current, keep the old as previous, run
# rekeyStorageBindings until it reports nothing left, then remove both
# PREVIOUS vars. See the comment in apps/convex/functions/storage.ts.
# STORAGE_SECRET_ENCRYPTION_KEY_PREVIOUS=
# STORAGE_SECRET_ENCRYPTION_KEY_PREVIOUS_ID=

# Control-plane shared secrets.
#
# Two of them, and they must never hold the same value. Each proves "this
# caller is <who>" and nothing else — see apps/convex/functions/lib/gatewayAuth.ts.
#
#   GATEWAY_SECRET       the MCP gateway (apps/mcp). Opens nothing on its own:
#                        every route it reaches also requires an end user's
#                        OAuth access token.
#   EMAIL_WORKER_SECRET  the Email Worker (infra/email-worker). An inbound email
#                        carries no user token, so this one can reach one
#                        person's storage credential with no human in the loop.
#                        Keeping it separate is what stops a compromised email
#                        worker from also being a compromised gateway.
#
# Each has to be set in TWO places, to the same value: the Convex environment,
# which checks it, and the worker's own secrets via `wrangler secret put`. Set
# on only one side and every request 401s — which for ingestion surfaces as mail
# silently going nowhere, because the worker turns every failure into one frozen
# SMTP rejection.
GATEWAY_SECRET=op://Context/GATEWAY_SECRET/production
EMAIL_WORKER_SECRET=op://Context/EMAIL_WORKER_SECRET/production

# Sentry
SENTRY_DSN=op://Context/Sentry/dsn
