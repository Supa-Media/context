  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "pnpm": {
    "patchedDependencies": {
      "@convex-dev/auth": "patches/@convex-dev__auth.patch"
    },
    "overrides": {
      "dompurify@<3.4.17": "^3.4.17",
      "lodash-es@<4.18.0": "^4.18.1",
      "nanoid@<3.3.18": "^3.3.18",
