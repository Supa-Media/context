{
  "name": "context",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:mobile": "node scripts/dev.js --mobile",
    "dev:convex": "node scripts/dev.js --convex",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
