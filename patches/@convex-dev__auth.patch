+// PATCH(context.lc): a stored JWT must have at least this long to live before
+// a forced fetch will reuse it instead of rotating the refresh token.
+const REUSE_MIN_VALIDITY_MS = 60000;
+// PATCH(context.lc): true when the JWT's exp claim is more than marginMs away.
+// Anything unparseable counts as expired, which falls back to a real rotation.
+function jwtValidForAtLeast(jwt, marginMs) {
+    try {
+        const payload = jwt.split(".")[1];
+        const claims = JSON.parse(atob(payload.replace(/-/g, "+").replace(/_/g, "/")));
+        return (typeof claims.exp === "number" &&
+            claims.exp * 1000 - Date.now() > marginMs);
+    }
+    catch {
+        return false;
+    }
+}
