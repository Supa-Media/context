+/**
+ * PATCH(context.lc): how a sign-in code is kept in `authVerificationCodes`.
+ *
+ * Upstream stores an unsalted SHA-256 of the code. A six-digit code is one of a
+ * million, so a copy of that table gives every live code back in well under a
+ * second (CASA 1.1.3, 2026-11-11). This is an HMAC under a key that lives only
+ * in the deployment's environment, never in the database: `AUTH_CODE_HASH_KEY`
+ * when set, otherwise the auth signing key every deployment already has. A
+ * leaked table without the environment recovers nothing, and with the
+ * environment the signing key is already lost, which is worse than any code.
+ *
+ * Deterministic on purpose: the library finds a code by this value through an
+ * index. A per-row salt would make that lookup impossible; the key does the
+ * job a salt cannot here. Context's own code stores use the same scheme
+ * (`apps/convex/functions/lib/oneTimeCodes.ts`, purpose `convex-auth`).
+ */
+export async function hashVerificationCode(input) {
+    const material = process.env.AUTH_CODE_HASH_KEY?.trim() || process.env.JWT_PRIVATE_KEY?.trim();
+    if (!material) {
+        throw new Error("Sign-in codes need AUTH_CODE_HASH_KEY or JWT_PRIVATE_KEY on the deployment.");
+    }
+    const encoder = new TextEncoder();
+    const key = await crypto.subtle.importKey("raw", encoder.encode(material), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
+    const mac = await crypto.subtle.sign("HMAC", key, encoder.encode(`context-one-time-code:v1:convex-auth:${input}`));
+    return encodeHexLowerCase(new Uint8Array(mac));
+}
