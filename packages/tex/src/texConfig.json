    {"label":"Answer check","goal":"Check a draft before it goes: code first catches what it can prove wrong (a claim with no call behind it, a figure nothing showed, a missing link); for a report or routine a model then reads it as the person would. Either can send it back to the front door.","log":true,"on":true,"rounds":1,"out":300,"ctx":["own","ledger","ask","draft","hist","date"],"ms":0,"timeoutS":8,"areas":["review"],"file":"graph/nodes/checks.js · graph/nodes/reviewer.js · replyJudge.js · sendBack.js","note":"","icon":"judge","model":"haiku-5-5","x":560,"y":340,"effort":"low","id":"answerCheck","inSchema":[{"name":"pending","type":"yesno"},{"name":"draftChars","type":"number","optional":true},{"name":"actions","type":"number","optional":true},{"name":"ended","type":"yesno","optional":true},{"name":"status","type":"number","optional":true},{"name":"answeredBy","type":"text","optional":true},{"name":"steps","type":"number","optional":true},{"name":"exhausted","type":"yesno","optional":true},{"name":"model","type":"text","optional":true},{"name":"effort","type":"text","optional":true},{"name":"fallback","type":"text","optional":true},{"name":"router","type":"yesno","optional":true},{"name":"reviewer","type":"text","optional":true},{"name":"advisor","type":"text","optional":true},{"name":"planner","type":"text","optional":true},{"name":"computers","type":"number","optional":true},{"name":"skills","type":"number","optional":true},{"name":"delegation","type":"yesno","optional":true},{"name":"threads","type":"yesno","optional":true}],"outSchema":[{"name":"pending","type":"yesno"},{"name":"draftChars","type":"number","optional":true},{"name":"actions","type":"number","optional":true},{"name":"ended","type":"yesno","optional":true},{"name":"status","type":"number","optional":true},{"name":"answeredBy","type":"text","optional":true},{"name":"steps","type":"number","optional":true},{"name":"exhausted","type":"yesno","optional":true},{"name":"model","type":"text","option