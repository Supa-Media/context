    {"id":"nightly","label":"Nightly","goal":"Start each night's work for a person: the dream and the summaries of their days, and housekeeping, each on the schedule the control plane keeps.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"dream.js · housekeeping.js","note":"","icon":"beat","kind":"input","model":"code","x":0,"y":760,"inSchema":[{"name":"run","type":"choice","options":"dream, housekeeping"},{"name":"timeZone","type":"text"},{"name":"since","type":"number","optional":true}],"outSchema":[{"name":"to","type":"choice","options":"dream, housekeeping"},{"name":"timeZone","type":"text"},{"name":"since","type":"number","optional":true}]},
    {"id":"dream","label":"Dream","goal":"Read the chat since the last dream and the memories that fit, and keep About me true: add what was learned, take out what is no longer so.","log":true,"on":true,"rounds":20,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"dream.js","note":"","icon":"star","model":"haiku-5-5","effort":"low","x":280,"y":760,"inSchema":[{"name":"to","type":"choice","options":"dream"},{"name":"timeZone","type":"text"},{"name":"since","type":"number","optional":true}],"outSchema":[{"name":"outcome","type":"text"},{"name":"status","type":"number"},{"name":"body","type":"object"},{"name":"timeZone","type":"text"},{"name":"now","type":"number"}]},
    {"id":"daysum","label":"Day summaries","goal":"Sum up each finished day of the chat not yet summed up, into the chat's ledger, for later turns.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"daySummaries.js","note":"","icon":"thread","model":"haiku-5-5","effort":"low","x":560,"y":760,"inSchema":[{"name":"outcome","type":"text"},{"name":"status","type":"number"},{"name":"body","type":"object"},{"name":"when","type":"list","optional":true},{"name":"timeZone","type":"text"},{"name":"now","type":"number"}],"outSchema":[{"name":"outcome","type":"choice","options":"done, off, failed"}]},
    {"id":"housekeep","label":"Housekeeping","goal":"Tidy their workspace once a day within its time limit: fix what the health check names, change nothing it cannot undo, and log each change.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"housekeeping.js","note":"","icon":"trash","model":"haiku-5-5","effort":"low","x":280,"y":900,"inSchema":[{"name":"to","type":"choice","options":"housekeeping"},{"name":"timeZone","type":"text"}],"outSchema":[{"name":"outcome","type":"text"},{"name":"status","type":"number"},{"name":"body","type":"object"}]},
    {"label":"Door","goal":"Gather what the turn needs (the text, routine, question, yes or no, what may leave, may it run, history, web, setup, bookkeeping) in code before any model runs; each part logged inside this step.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":["core","pipeline"],"file":"texEntryPoint/*","note":"","icon":"door","model":"code","x":440,"y":330,"id":"doorStep","group":"intake","outSchema":[{"name":"texted","type":"yesno","optional":true},{"name":"claims","type":"yesno","optional":true},{"name":"tries","type":"yesno","optional":true},{"name":"forwarding","type":"number","optional":true},{"name":"pictures","type":"yesno","optional":true},{"name":"knowsStarted","type":"yesno","optional":true},{"name":"status","type":"number","optional":true},{"name":"answeredBy","type":"text","optional":true}]},
    {"id":"shapeGate","label":"Shape gate","goal":"Beside the Door, read what kind of answer this text takes: how the turn ends (a tapback, one line, an answer, a report, or on it and a job), whether it is an order to act, and whether it asks about something stored. The Front door is told the read, and the code checks hold it where it was sure, never on a text that tagged Tex.","log":true,"on":false,"rounds":1,"out":20,"ctx":[],"ms":0,"timeoutS":3,"areas":["core"],"file":"graph/nodes/shapeGate.js · shapeGate.js · doItChecks.js","note":"Off until a Training and two Dev runs score it (tex-quality-architecture-2026-11-17, change 2).","icon":"judge","model":"clef","inSchema":[{"name":"question","type":"text"},{"name":"group","type":"yesno"}],"outSchema":[{"name":"to","type":"choice","options":"read, none"},{"name":"ending","optional":true,"type":"choice","options":"tapback, one_line, answer, report, job"},{"name":"endingSure","optional":true,"type":"score","options":"0-1"},{"name":"order","optional":true,"type":"score","options":"0-1"},{"name":"records","optional":true,"type":"score","options":"0-1"}],"x":1120,"y":340,"group":"tools-subagents"},
