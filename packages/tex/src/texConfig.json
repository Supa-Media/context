    {"label":"Confirmations & refusals","goal":"Answers the door settles in code, with no model: a yes, no or thumbs-up to something Tex is waiting on (including a computer step), and the short refusals (a request that can't be read, a question too long, not allowed to run, the model unavailable). Logs which one and why, then hands it to Text them.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"graph/nodes/bypass.js","note":"","icon":"code","model":"code","x":280,"y":500,"id":"bypass","inSchema":[{"name":"answeredBy","type":"text"},{"name":"status","type":"number","optional":true}],"outSchema":[{"name":"answeredBy","type":"text"},{"name":"status","type":"number","optional":true}]},
    {"label":"Chat day summaries","goal":"After a reply, sum up each finished day of this chat (1:1 or group) in the last 3 weeks not yet summed up, 3 a run, into the chat's ledger, for the 7-day history to show before the last 7 days.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"graph/nodes/chatDays.js · daySummaries.js","note":"","icon":"thread","model":"haiku-5-5","x":1700,"y":560,"effort":"low","id":"chatDays","inSchema":[{"name":"texts","optional":true,"type":"number"},{"name":"card","optional":true,"type":"yesno"},{"name":"reaction","optional":true,"type":"yesno"},{"name":"status","optional":true,"type":"number"}],"outSchema":[{"name":"outcome","type":"text"},{"name":"written","optional":true,"type":"number"},{"name":"missing","optional":true,"type":"number"}]},
    {"label":"Move judge","goal":"Before a texted turn moves or archives a note of theirs the word list didn't clear, read their recent texts and Tex's own offer and say whether they asked for it; a note that isn't there is never kept as theirs.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":8,"areas":["core"],"file":"graph/nodes/moveJudge.js · theirNotes.js","note":"","icon":"scale","model":"haiku-5-5","x":1400,"y":900,"effort":"low","group":"tools-subagents","id":"moveJudge"},
    {"label":"Cross-chat gate","goal":"Before Tex in one chat asks Tex in another (ask_chat): a 1:1 may ask its person's groups, a group the tagger's personal Tex, never group to group; one open ask per pair, 10 an hour, 40 a day.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"graph/nodes/crossChatGate.js · crossChat.js","note":"","icon":"code","model":"code","x":840,"y":120,"group":"tools-subagents","id":"crossChatGate","inSchema":[{"name":"from","type":"text"},{"name":"to","type":"object"},{"name":"what","type":"text"},{"name":"do","optional":true,"type":"yesno"},{"name":"guest","optional":true,"type":"yesno"},{"name":"counts","optional":true,"type":"object"}],"outSchema":[{"name":"to","options":"ask, refuse","type":"choice"},{"name":"ask","optional":true,"type":"object"},{"name":"why","optional":true,"type":"text"}]},
    {"label":"Another chat asks","goal":"Starts a run in this chat for another chat's ask, or for the answer to this chat's own ask; the other chat's words are marked as not the person's.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"graph/nodes/chatAsk.js","note":"","icon":"code","model":"code","x":0,"y":200,"id":"chatAsk","inSchema":[{"name":"event","type":"text"},{"name":"crossChat","type":"object"},{"name":"group","optional":true,"type":"yesno"}],"kind":"input","outSchema":[{"name":"to","options":"ask, answer, refuse","type":"choice"},{"name":"event","optional":true,"type":"object"},{"name":"question","optional":true,"type":"text"},{"name":"prompt","optional":true,"type":"text"},{"name":"why","optional":true,"type":"text"}]},
    {"label":"Answer the other chat","goal":"An ask-run's checked draft goes back to the chat that asked instead of being texted here; a do-ask in a group posts one signed line.","log":true,"on":true,"rounds":1,"out":300,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"graph/nodes/chatAnswer.js","note":"","icon":"code","model":"code","x":840,"y":340,"id":"chatAnswer","inSchema":[{"name":"kind","type":"text"},{"name":"id","type":"text"},{"name":"draft","optional":true,"type":"text"},{"name":"post","optional":true,"type":"text"}],"outSchema":[{"name":"to","options":"back","type":"choice"},{"name":"id","type":"text"},{"name":"state","type":"text"},{"name":"texts","type":"list"},{"name":"post","optional":true,"type":"text"}]},
    {"label":"Tapback","goal":"When the Front door answers their text with only a tapback and no words, check it may: one of the 64 emoji, not right after a call that failed, never on a literal @Tex tag (answered in words). The Worker then reacts to their text with it.","log":true,"on":true,"rounds":1,"out":100,"ctx":[],"ms":0,"timeoutS":0,"areas":[],"file":"graph/nodes/tapback.js · tapbackEnding.js","note":"","icon":"code","model":"code","x":1120,"y":120,"group":"tools-subagents","id":"tapback","inSchema":[{"name":"emoji","type":"text"},{"name":"why","optional":true,"type":"text"},{"name":"lastFailed","optional":true,"type":"yesno"},{"name":"tagged","optional":true,"type":"yesno"}],"outSchema":[{"name":"to","options":"react, refuse","type":"choice"},{"name":"emoji","optional":true,"type":"text"},{"name":"why","optional":true,"type":"text"}]},
    {"label":"Part end","goal":"After each part of a background job, choose what follows: the next part, the last saved draft, or the end, under the job limits; a part out of steps with no room left ends as its own check said; a job still looking whose last parts found nothing new ends with what it has; a part refused at today's limit pauses the job until just after the limit resets.","log":true,"on":true,"rounds":0,"out":0,"ctx":[],"ms":0,"timeoutS":0,"areas":["jobs"],"file":"graph/nodes/partEnd.js · jobPartEnd.cjs · jobPartEndRoute.js · apps/agent jobPartEnd.ts","note":"","icon":"job","model":"code","x":1060,"y":220,"group":"jobs","id":"partEnd","inSchema":[{"name":"cause","type":"text"},{"name":"part","type":"number"},{"name":"startedAt","type":"number"},{"name":"now","type":"number"},{"name":"machine","optional":true,"type":"yesno"},{"name":"hasDraft","optional":true,"type":"yesno"},{"name":"idle","optional":true,"type":"yesno"},{"name":"wasIdle","optional":true,"type":"yesno"},{"name":"rejected","optional":true,"type":"yesno"},{"name":"refusal","optional":true,"type":"text"},{"name":"checked","optional":true,"options":"done, waiting, stuck","type":"choice"},{"name":"fresh","optional":true,"type":"number"},{"name":"staleBefore","optional":true,"type":"number"}],"limits":{"machineMinutes":240,"machineParts":96,"minutes":30,"parts":10,"resumeAfterMinutes":2,"staleParts":2},"outSchema":[{"name":"to","options":"carry, deliver, end","type":"choice"},{"name":"ended","optional":true,"options":"done, waiting, stuck, failed","type":"choice"},{"name":"cause","type":"text"},{"name":"room","type":"yesno"},{"name":"spinning","optional":true,"type":"yesno"},{"name":"stale","optional":true,"type":"yesno"},{"name":"resumeAt","optional":true,"type":"number"}]},
    {"label":"A job reports","goal":"Starts a run in the chat for a background job's report (its result, a failure, a sign-in link or an owner's ask); the report is read strictly and the run is asked the gateway's own line, never the job's words as the person's.","log":true,"on":true,"rounds":0,"out":0,"ctx":[],"ms":0,"timeoutS":0,"areas":["jobs"],"file":"graph/nodes/jobReport.js · jobReport.js · texEntryPoint/readTheText.js","note":"","icon":"job","model":"code","x":1060,"y":340,"group":"jobs","id":"jobReport","inSchema":[{"name":"jobReport","type":"object"}],"kind":"input","outSchema":[{"name":"to","options":"report, refuse","type":"choice"},{"name":"report","optional":true,"type":"object"},{"name":"question","optional":true,"type":"text"},{"name":"why","optional":true,"type":"text"}]},
    {"label":"Job start","goal":"When the front door asks for a background job, choose what follows: start it, pass the ask to the job already doing it, wait for a free slot, or refuse an ask with no title or brief, under the job slots.","log":true,"on":true,"rounds":0,"out":0,"ctx":[],"ms":0,"timeoutS":0,"areas":["jobs"],"file":"graph/nodes/jobStart.js · jobStart.cjs · jobStartChoice.js · background.js","note":"","icon":"job","model":"code","x":900,"y":220,"group":"jobs","id":"jobStart","inSchema":[{"name":"hasTitle","type":"yesno"},{"name":"hasBrief","type":"yesno"},{"name":"already","optional":true,"type":"object"},{"name":"computer","optional":true,"type":"object"},{"name":"cloudBusy","optional":true,"type":"number"},{"name":"machineBusy","optional":true,"type":"number"}],"limits":{"cloudSlots":3,"machineSlots":8},"outSchema":[{"name":"to","options":"start, already, full, refuse","type":"choice"},{"name":"where","optional":true,"type":"text"},{"name":"slots","optional":true,"type":"number"},{"name":"title","optional":true,"type":"text"},{"name":"startedAt","optional":true,"type":"number"},{"name":"status","optional":true,"type":"text"},{"name":"why","optional":true,"type":"text"}]}
