{
  // context-router: the Cloudflare Worker fronting https://context.lc.
  //
  // Full routing table lives in src/route.ts's module comment. In short:
  //   - context.lc (apex): /api/auth/* -> Convex HTTP actions, /og/card.png ->
  //     the Worker's own OpenGraph card, everything else -> the versioned web
  //     export in Workers Static Assets (or, for a link-preview crawler,
  //     server-rendered meta tags). Paths are never rewritten.
  //   - www.context.lc -> 301 https://context.lc<path><search>
  //
  // Worker code and the web export are deployed and rolled back together.
  //
  // CUSTOM DOMAINS ARE NOT ATTACHED HERE. This file intentionally has no
  // top-level "routes"/"route" key. `context.lc` and `www.context.lc` are
  // attached to this Worker as Custom Domains in the Cloudflare dashboard by
  // the account owner, because that requires the zone to already be on
  // Cloudflare DNS — something a CI deploy cannot do and should not silently
  // try to. Same convention as events-os's infra/router.
  //
  // `mcp.context.lc` belongs to a DIFFERENT Worker (the MCP gateway in
  // apps/mcp). Do not attach it here: customer storage credentials should not
  // travel one hop further than they have to.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "context-router",
  "main": "src/index.ts",
  // A stable past date rather than "today": a future-dated (or clock-skewed)
  // CI runner rejects a compatibility_date that resolves to the future.
  "compatibility_date": "2026-07-01",

  // Bundle src/og-card.png as bytes, so `import ogCard from "./og-card.png"`
  // in src/index.ts resolves to an ArrayBuffer. The 1200x630 OpenGraph card
  // ships inside the Worker rather than as an Expo bundle asset, because the
  // one request every link-preview crawler is guaranteed to make should not
  // depend on an upstream that might be mid-deploy. src/assets.d.ts declares
  // the type for tsc, which knows nothing about this rule.
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.png"],
      "fallthrough": false
    }
  ],

  "vars": {
    // CONVEX_ORIGIN — the Convex HTTP-actions origin: https://<deployment>.
    // convex.site, the `.site` host, NOT the `.cloud` one the client library
    // uses — used to live here as a plaintext var. It named which Convex
    // deployment this repository's production deploy talks to, which is an
    // account identifier a public, MIT-licensed repo does not commit
    // (CLAUDE.md: "no internal hostnames, no account identifiers").
    //
    // It is now a `wrangler secret`, set by `deploy-router.yml` from the
    // `CONTROL_PLANE_URL` secret (the same origin the email worker and the
    // MCP gateway read under that name — one Convex deployment, three
    // Workers) via `wrangler secret put CONVEX_ORIGIN`. A Worker reads a
    // secret through `env.CONVEX_ORIGIN` exactly like a var, so
    // `src/index.ts` needed no change.
    //
    // Locally, `wrangler dev` reads a `.dev.vars` file for the same name —
    // see Cloudflare's docs on local secrets; nothing here commits one.
    //
    // If it is unset (no secret configured yet, e.g. a fresh self-hosted
    // deploy), the Worker fails CLOSED: /api/auth/* returns a 503 naming this
    // variable, and the rest of the site is unaffected.
  },

  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../../apps/mobile/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "env": {
    "staging": {
      "name": "context-router-staging",
      "workers_dev": true,
      "vars": {},
      // Staging only: /texts-simulator goes to the texting assistant's
      // simulator (apps/agent/src/simulator.ts). Production has no binding,
      // so the path is an ordinary app 404 there.
      "services": [{ "binding": "TEXTS_SIMULATOR", "service": "context-agent-staging" }],
      // Environments do not inherit Static Assets configuration, so keep the
      // staging binding explicit and identical to production.
      // `run_worker_first` preserves auth, previews, customer domains and the
      // dynamic homepage before `index.ts` hands ordinary app requests to the
      // binding. The SPA fallback keeps deep links working.
      "assets": {
        "directory": "../../apps/mobile/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      }
    }
  }
}
