.sentryclirc

# Cloudflare Workers
.wrangler/
apps/mcp/bin/

# Generated by apps/mobile/__tests__/shots.render.ts. The PNGs beside them are
# the evidence and are committed; the HTML is the intermediate.
docs/shots/*.html
