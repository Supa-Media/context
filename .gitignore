# Dependencies
node_modules

# Environment
.env
.env.local
.env.*.local

# Build outputs
dist/
# electron-builder's output (`directories.output` in apps/desktop/electron-builder.yml):
# a packaged, signed .app and its DMGs — 873MB the first time anyone runs
# `pnpm --filter @context/desktop package`, and never a thing to commit.
release/
.next/
.expo/
*.tsbuildinfo

# Convex
.convex/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Turbo
.turbo/

# EAS
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Prebuild output. This app is managed workflow — `expo prebuild` is a local
# check that the config plugins apply and the Info.plist/entitlements come out
# right, not something we keep. Committing it would silently switch the app to
# bare workflow and make app.config.js stop being the source of truth.
apps/mobile/ios/
apps/mobile/android/

# Sentry
.sentryclirc

# Cloudflare Workers
.wrangler/
apps/mcp/bin/

# Generated by apps/mobile/__tests__/shots.render.ts. The PNGs beside them are
# the evidence and are committed; the HTML is the intermediate.
docs/shots/*.html

# The `expo export --platform web` output `pnpm build:e2e-web` produces and
# `apps/mobile/e2e/webkit` serves — a build artifact, not source, like every
# other `dist/` in this list.
apps/mobile/web-build/
apps/mobile/e2e/webkit/playwright-report/
apps/mobile/e2e/webkit/test-results/

# The standalone drawing editor and its fonts, built by
# `scripts/build-drawing-editor.mjs` so the console can serve them from its own
# origin instead of a CDN (see `features/console/files/drawingBridge.ts` for
# why the editor is a separate page at all). Not committed: it is megabytes of
# a dependency's code, and a committed copy is a second thing to keep in step
# with every version bump.
apps/mobile/public/drawing-assets/

# Isolated git worktrees the agent harness creates for background agents, one
# per agent (`.claude/worktrees/agent-<id>/`). Each is a full checkout of this
# repository, `.git` and all, so a stray `git add -A` in the primary checkout
# would commit a repository inside the repository. `.claude/settings.json` is
# tracked and stays tracked; only the scratch worktrees are ignored.
.claude/worktrees/
